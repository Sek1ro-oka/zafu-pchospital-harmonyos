# 复制为 .env，替换本机密码。不要提交 .env。
EXPERIMENT_DEV_DB=pchospital_exp_local
EXPERIMENT_TEST_DB=pchospital_exp_local_test
DATABASE_URL=mysql://pchospital_local:replace-password@127.0.0.1:3308/pchospital_exp_local
TEST_DATABASE_URL=mysql://pchospital_local_test:replace-password@127.0.0.1:3308/pchospital_exp_local_test
AUTH_SECRET=replace-with-random-at-least-32-bytes
INVITE_CODE_PEPPER=replace-with-random-at-least-32-bytes
PII_AUDIT_PEPPER=replace-with-random-at-least-32-bytes
APP_BASE_URL=http://localhost:13080
RECRUITMENT_CYCLE=experiment-2026-autumn
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_FILES_PER_REPAIR=9
ACADEMIC_TERM_START=
ACADEMIC_TERM_END=
# Issue #39 知识问答（可选；不配置 AI_API_KEY 时问答接口返回 AI_NOT_CONFIGURED，不配置 EMBEDDING_API_KEY 时检索自动降级为关键词）
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=
AI_TIMEOUT_MS=45000
AI_TOTAL_BUDGET_MS=50000
AI_MAX_OUTPUT_TOKENS=1000
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_MS=30000
# 生成索引路径（相对 backend/，默认即此值；索引与缓存已 gitignore）
# KNOWLEDGE_INDEX_PATH=data/knowledge/index/knowledge-index.json
