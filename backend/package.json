{
  "name": "zafu-pchospital-experiment-api",
  "version": "0.1.0",
  "private": true,
  "description": "浙江农林大学电脑医院 · 社团综合服务平台官网",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "scripts": {
    "setup:local": "node tools/setup-local.mjs",
    "postinstall": "prisma generate && node tools/ensure-doc-manifest.mjs",
    "predev": "node tools/ensure-doc-manifest.mjs",
    "dev": "next dev",
    "build": "node tools/ensure-doc-manifest.mjs && next build",
    "prebuild:site": "node tools/ensure-doc-manifest.mjs",
    "build:site": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate:dev": "node tools/db-task.mjs migrate-dev",
    "db:migrate:deploy": "node tools/db-task.mjs migrate",
    "db:migrate:test": "node tools/db-task.mjs migrate-test",
    "db:seed": "node tools/db-task.mjs seed",
    "db:seed:test": "node tools/db-task.mjs seed-test",
    "db:reset:test": "node tools/db-task.mjs reset-test",
    "db:health": "tsx tools/db-health.ts",
    "accounts:prepare": "tsx tools/prepare-test-accounts.ts",
    "knowledge:sync": "tsx tools/knowledge-sync.ts",
    "knowledge:index": "tsx tools/knowledge-index.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:db": "node tools/db-task.mjs test"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-table": "8.21.3",
    "exceljs": "^4.4.0",
    "mariadb": "3.4.5",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.5.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "7.10.0",
    "tailwindcss": "^4.1.13",
    "tsx": "4.20.6",
    "typescript": "^5.8.3"
  }
}
