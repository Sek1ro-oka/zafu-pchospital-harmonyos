/// 成员本场出勤。无出勤不可签到客户 / 不可接待。
model RepairActivityAttendance {
  id              String         @id @db.Char(36)
  activityId      String         @map("activity_id") @db.Char(36)
  memberProfileId String         @map("member_profile_id") @db.Char(36)
  checkedInAt     DateTime       @map("checked_in_at") @db.DateTime(3)
  cancelledAt     DateTime?      @map("cancelled_at") @db.DateTime(3)
  businessStartedAt DateTime?    @map("business_started_at") @db.DateTime(3)
  activity        RepairActivity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  memberProfile   MemberProfile  @relation(fields: [memberProfileId], references: [id], onDelete: Restrict)

  @@unique([activityId, memberProfileId], map: "repair_activity_attendance_activity_member_uq")
  @@index([memberProfileId], map: "repair_activity_attendance_member_idx")
  @@map("repair_activity_attendances")
}

/// Issue #40 典型案例（知识自动整理与回流）。
///
/// 由已审核维修备案（`isTypical` 标记）经模型整理/自动合并生成，默认内部
/// （`STAFF`）可见，管理员可调整为 `PUBLIC`。**检索与来源读取以本表为权威**：
/// 仅 `status = PUBLISHED` 的案例参与混合检索；撤回（`WITHDRAWN`）、重整中
/// （`REPROCESSING`）、失败（`FAILED`）一律不参与，旧引用按过期处理。
model KnowledgeCase {
  id                   String    @id @db.Char(36)
  /// 展示与检索正文（结构化字段的确定性渲染，模型不直接写这里）。
  displayText          String    @map("display_text") @db.Text
  /// 结构化正文：标题/机型/故障现象/排查过程/原因/处置/结果/分类/差异说明/未知项。
  structured           Json
  /// PUBLISHED / REPROCESSING / FAILED / WITHDRAWN
  status               String    @db.VarChar(32)
  /// STAFF / PUBLIC
  visibility           String    @db.VarChar(16)
  /// 内容版本：每次重新发布 +1。引用块 ID 与版本绑定，正文变化后旧版本引用过期。
  contentVersion       Int       @default(1) @map("content_version")
  /// displayText 的内容哈希：判断「未变内容」以复用向量缓存。
  contentHash          String    @map("content_hash") @db.VarChar(64)
  /// 最近一次发布使用的模型与提示词版本（可追溯）。
  model                String?   @db.VarChar(64)
  promptVersion        String?   @map("prompt_version") @db.VarChar(32)
  /// 案例向量（Float32 LE）与指纹；`embeddingStatus` 如实标注 READY/FAILED/PENDING。
  embedding            Bytes?    @db.Blob
  embeddingFingerprint String?   @map("embedding_fingerprint") @db.VarChar(128)
  embeddingStatus      String    @default("PENDING") @map("embedding_status") @db.VarChar(16)
  embeddingError       String?   @map("embedding_error") @db.VarChar(500)
  /// 撤回来源：ADMIN（管理员主动；普通重试/重建不会自动恢复）或 SOURCES_EXHAUSTED（无有效来源自动撤下）。
  withdrawnSource      String?   @map("withdrawn_source") @db.VarChar(32)
  withdrawnAt          DateTime? @map("withdrawn_at") @db.DateTime(3)
  withdrawnByUserId    String?   @map("withdrawn_by_user_id") @db.Char(36)
  /// 最近一次处理/重整失败的真实原因（不伪装成功）。
  failureCode          String?   @map("failure_code") @db.VarChar(64)
  failureMessage       String?   @map("failure_message") @db.VarChar(500)
  publishedAt          DateTime? @map("published_at") @db.DateTime(3)
  createdAt            DateTime  @map("created_at") @db.DateTime(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  sources              KnowledgeCaseSource[]
  withdrawnBy          User?     @relation("KnowledgeCaseWithdrawnBy", fields: [withdrawnByUserId], references: [id], onDelete: Restrict)

  @@index([status, visibility, updatedAt], map: "knowledge_cases_status_visibility_idx")
  @@map("knowledge_cases")
}

/// 案例来源贡献：一条已审核维修备案当前至多归属一个有效案例（唯一约束保护）。
///
/// 备案正文实质变化、取消典型或软删时移除贡献（`caseId` 置空、状态 REMOVED），
/// 受影响案例自动基于剩余有效来源重整。处理并发由 `generation` 租约控制。
model KnowledgeCaseSource {
  id                  String       @id @db.Char(36)
  repairRecordId      String       @unique(map: "knowledge_case_sources_record_uq") @map("repair_record_id") @db.Char(36)
  caseId              String?      @map("case_id") @db.Char(36)
  /// PENDING / PROCESSING / PUBLISHED / FAILED / REMOVED
  status              String       @db.VarChar(32)
  /// 备案实质内容哈希（机型/分类/正文/结果/备注归一化后 sha256）。
  contentHash         String       @map("content_hash") @db.VarChar(64)
  /// 来源证据快照：备案文字字段与发布时的引用/证据对应关系。
  evidence            Json?
  /// 处理代次（租约）：接管过期处理时 +1，旧代次结果不得发布。
  generation          Int          @default(0)
  processingStartedAt DateTime?    @map("processing_started_at") @db.DateTime(3)
  failureCode         String?      @map("failure_code") @db.VarChar(64)
  failureMessage      String?      @map("failure_message") @db.VarChar(500)
  processedAt         DateTime?    @map("processed_at") @db.DateTime(3)
  createdAt           DateTime     @map("created_at") @db.DateTime(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  record              RepairRecord @relation(fields: [repairRecordId], references: [id], onDelete: Restrict)
  case                KnowledgeCase? @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([caseId, status], map: "knowledge_case_sources_case_status_idx")
  @@index([status, updatedAt], map: "knowledge_case_sources_status_updated_idx")
  @@map("knowledge_case_sources")
}

// ---------------------------------------------------------------------------
// Issue #84 选购交易：商品、商品图片、订单。
//
// 状态与分类一律用字符串（全库无 Prisma enum 先例），合法值/状态转移写在
// `src/features/shopping/shopping-types.ts`；金额用 Int 整数分，不用 Decimal。
// 商品与订单不做软删除：下架是商品状态，订单是交易凭证；订单快照写入后不改写。
// ---------------------------------------------------------------------------

model Product {
  id           String         @id @db.Char(36)
  sellerId     String         @map("seller_id") @db.Char(36)
  title        String         @db.VarChar(120)
  description  String         @db.Text
  priceCents   Int            @map("price_cents") @db.Int
  /// SECONDHAND / CONSUMABLE
  category     String         @db.VarChar(32)
  /// 成色/规格的自由文本（如「九成新」「原装硒鼓」），由客户端展示，不做枚举。
  condition    String         @db.VarChar(32)
  /// 可售库存。下单在事务里条件扣减，取消时只回补一次。
  stock        Int            @db.Int
  /// ON_SALE / DELISTED
  status       String         @db.VarChar(32)
  pickupNote   String?        @map("pickup_note") @db.VarChar(255)
  delistReason String?        @map("delist_reason") @db.VarChar(255)
  delistedBy   String?        @map("delisted_by") @db.Char(36)
  delistedAt   DateTime?      @map("delisted_at") @db.DateTime(3)
  createdAt    DateTime       @map("created_at") @db.DateTime(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  seller       User           @relation("ProductSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  images       ProductImage[]
  orders       ShoppingOrder[]

  @@index([status, category, createdAt], map: "products_status_category_created_idx")
  @@index([sellerId, createdAt], map: "products_seller_created_idx")
  @@map("products")
}

/// 商品图片。`url` 是公开读取地址；存储键/类型/长度单独留列，读取时不必猜扩展名。
///
/// `deletedAt` 是任务书字段外的扩展：订单快照保存图片 URL，后续若提供删除商品图能力，
/// 软删可让历史订单的图仍按 ID 读取，避免 404；本轮未提供删除接口。
model ProductImage {
  id         String    @id @db.Char(36)
  productId  String    @map("product_id") @db.Char(36)
  url        String    @db.VarChar(512)
  storageKey String    @unique(map: "product_images_storage_key_uq") @map("storage_key") @db.VarChar(255)
  mimeType   String    @map("mime_type") @db.VarChar(64)
  sizeBytes  Int       @map("size_bytes") @db.Int
  sortOrder  Int       @map("sort_order") @db.Int
  createdAt  DateTime  @map("created_at") @db.DateTime(3)
  deletedAt  DateTime? @map("deleted_at") @db.DateTime(3)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, sortOrder], map: "product_images_product_sort_idx")
  @@map("product_images")
}

/// 选购订单。商品标题/单价/首图在创建时写入快照，后续商品编辑或下架不回写历史订单。
model ShoppingOrder {
  id             String    @id @db.Char(36)
  productId      String    @map("product_id") @db.Char(36)
  buyerId        String    @map("buyer_id") @db.Char(36)
  sellerId       String    @map("seller_id") @db.Char(36)
  quantity       Int       @db.Int
  unitPriceCents Int       @map("unit_price_cents") @db.Int
  totalCents     Int       @map("total_cents") @db.Int
  titleSnapshot  String    @map("title_snapshot") @db.VarChar(120)
  imageSnapshot  String?   @map("image_snapshot") @db.VarChar(512)
  /// PENDING_PICKUP / COMPLETED / CANCELLED
  status         String    @db.VarChar(32)
  cancelReason   String?   @map("cancel_reason") @db.VarChar(255)
  cancelledBy    String?   @map("cancelled_by") @db.Char(36)
  idempotencyKey String    @map("idempotency_key") @db.VarChar(80)
  createdAt      DateTime  @map("created_at") @db.DateTime(3)
  completedAt    DateTime? @map("completed_at") @db.DateTime(3)
  cancelledAt    DateTime? @map("cancelled_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  product        Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  buyer          User      @relation("ShoppingOrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller         User      @relation("ShoppingOrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)

  @@unique([buyerId, idempotencyKey], map: "shopping_orders_buyer_idem_uq")
  @@index([buyerId, createdAt], map: "shopping_orders_buyer_created_idx")
  @@index([sellerId, createdAt], map: "shopping_orders_seller_created_idx")
  @@index([productId, createdAt], map: "shopping_orders_product_created_idx")
  @@map("shopping_orders")
}
