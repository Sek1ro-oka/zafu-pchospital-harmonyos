/// M4 维修记录评论。两层结构：根评论 parentCommentId 为空，回复一律挂到根评论。
/// 删除走 deletedAt 软删除，正文保留供审计，默认读取排除已删行。
model RepairComment {
  id                    String           @id @db.Char(36)
  repairRecordId        String           @map("repair_record_id") @db.Char(36)
  authorMemberProfileId String           @map("author_member_profile_id") @db.Char(36)
  parentCommentId       String?          @map("parent_comment_id") @db.Char(36)
