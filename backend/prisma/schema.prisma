/// 客户报名。同活动同手机号仅一条有效报名（应用层 + 事务内查重）。
model RepairActivityRegistration {
  id                      String         @id @db.Char(36)
  activityId              String         @map("activity_id") @db.Char(36)
  userId                  String?        @map("user_id") @db.Char(36)
  name                    String         @db.VarChar(40)
  phone                   String         @db.VarChar(11)
  phoneLast4              String         @map("phone_last4") @db.VarChar(4)
  issueType               String         @map("issue_type") @db.VarChar(32)
  /// 机型（issue #68）：选填，接待落单时带进维修记录。
  deviceModel             String?        @map("device_model") @db.VarChar(60)
  status                  String         @db.VarChar(32)
  /// 报名时同意的免责声明版本与时间（issue #62 前端3）。历史报名没有签署动作，因此可空。
  consentVersion          String?        @map("consent_version") @db.VarChar(16)
  consentAcceptedAt       DateTime?      @map("consent_accepted_at") @db.DateTime(3)
  checkedInAt             DateTime?      @map("checked_in_at") @db.DateTime(3)
  servedAt                DateTime?      @map("served_at") @db.DateTime(3)
  servedByMemberProfileId String?        @map("served_by_member_profile_id") @db.Char(36)
  repairRecordId          String?        @unique(map: "repair_activity_regs_repair_record_uq") @map("repair_record_id") @db.Char(36)
  createdAt               DateTime       @map("created_at") @db.DateTime(3)
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt               DateTime?      @map("deleted_at") @db.DateTime(3)
  activity                RepairActivity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  user                    User?          @relation("ActivityRegistrant", fields: [userId], references: [id], onDelete: Restrict)
  servedBy                MemberProfile? @relation("RepairActivityServedBy", fields: [servedByMemberProfileId], references: [id], onDelete: Restrict)
  repairRecord            RepairRecord?  @relation(fields: [repairRecordId], references: [id], onDelete: Restrict)

  @@index([activityId, phone], map: "repair_activity_regs_activity_phone_idx")
  @@index([userId, deletedAt, createdAt, id], map: "repair_activity_regs_user_deleted_created_idx")
  @@index([activityId, status, checkedInAt], map: "repair_activity_regs_activity_status_checked_idx")
  @@index([activityId, deletedAt], map: "repair_activity_regs_activity_deleted_idx")
